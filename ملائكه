local function GetPlayerInfo(player)
    local devInfo = RankSystem.Developers[player.Name]
    if devInfo then
        return {
            Rank = devInfo.RankName,
            CustomName = player.DisplayName,
            Prefix = devInfo.Prefix,
            Color = devInfo.Color,
            PermissionLevel = devInfo.PermissionLevel
        }
    else
        return {
            Rank = RankSystem.Member.RankName,
            CustomName = player.DisplayName,
            Prefix = RankSystem.Member.Prefix,
            Color = RankSystem.Member.Color,
            PermissionLevel = RankSystem.Member.PermissionLevel
        }
    end
end


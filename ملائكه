local TagEnabled = true
local ActiveTags = {}

local function removeTag(plr)
    if plr and plr.Character then
        local t = plr.Character:FindFirstChild("NameTag")
        if t then
            t:Destroy()
            ActiveTags[plr.UserId] = nil
        end
    end
end

local function createTag(plr)
    if not TagEnabled or not plr or not plr.Character or ActiveTags[plr.UserId] then return end

    -- التحقق من تفعيل اللاعب للسكربت أو كونه مطوراً
    local isDev = RankSystem.Developers[plr.Name] ~= nil
    local isActiveUser = _G.AngelHub_ActiveUsers and _G.AngelHub_ActiveUsers[plr.Name]

    -- عدم إظهار التاج للآخرين إلا لو كانوا مفعلين السكربت أو مطورين
    if plr ~= LocalPlayer and not isDev and not isActiveUser then
        return
    end

    local head = plr.Character:FindFirstChild("Head")
    if not head then return end

    removeTag(plr)

    local pInfo = GetPlayerInfo(plr)

    local gui = Instance.new("BillboardGui")
    gui.Name = "NameTag"
    gui.Adornee = head
    gui.Parent = plr.Character
    gui.Size = UDim2.new(4, 0, 1.5, 0)
    gui.StudsOffset = Vector3.new(0, 3.5, 0)
    gui.AlwaysOnTop = true

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local gradient = Instance.new("UIGradient", frame)
    gradient.Rotation = 90

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 2

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = pInfo.Rank
    
    if pInfo.PermissionLevel == 3 then
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
            ColorSequenceKeypoint.new(0.5, pInfo.Color),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0))
        }
        stroke.Color = pInfo.Color
        stroke.Thickness = 3
        label.TextColor3 = pInfo.Color
    else
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 50, 50)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 20, 20))
        }
        stroke.Color = Color3.fromRGB(0, 0, 0)
        label.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    
    ActiveTags[plr.UserId] = true
end

local function updateAllTags()
    for _, plr in ipairs(Players:GetPlayers()) do
        createTag(plr)
    end
end

InfoTab:AddToggle({
    Name = "إظهار الرتب فوق اللاعبين",
